+// license:BSD-3-Clause
+// copyright-holders:ZKM
+#include "emu.h"
+#include "midi_bridge.h"
+
+DEFINE_DEVICE_TYPE(MIDI_BRIDGE, midi_bridge_device, "midi_bridge", "Serial MIDI interface bridge")
+
+midi_bridge_device::midi_bridge_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock) :
+	device_t(mconfig, MIDI_BRIDGE, tag, owner, clock),
+	device_serial_interface(mconfig, *this),
+	device_rs232_port_interface(mconfig, *this),
+	m_stream(*this, "stream"),
+	m_input_count(0),
+	m_input_index(0),
+	m_timer_poll(nullptr)
+{
+}
+
+void midi_bridge_device::device_add_mconfig(machine_config &config)
+{
+	BITBANGER(config, m_stream);
+}
+
+void midi_bridge_device::device_start()
+{
+	m_timer_poll = timer_alloc(FUNC(midi_bridge_device::update_queue), this);
+	save_item(NAME(m_input_buffer));
+	save_item(NAME(m_input_count));
+	save_item(NAME(m_input_index));
+}
+
+void midi_bridge_device::device_reset()
+{
+	set_data_frame(1, 8, PARITY_NONE, STOP_BITS_1);
+	set_rate(31250);
+	output_rxd(1);
+	output_dcd(0);
+	output_dsr(0);
+	output_cts(0);
+	m_input_count = m_input_index = 0;
+	update_queue(0);
+}
+
+TIMER_CALLBACK_MEMBER(midi_bridge_device::update_queue)
+{
+	if (!is_transmit_register_empty())
+		return;
+	if (m_input_index == m_input_count)
+	{
+		m_input_index = 0;
+		m_input_count = m_stream->input(m_input_buffer, sizeof(m_input_buffer));
+	}
+	if (m_input_index != m_input_count)
+	{
+		transmit_register_setup(m_input_buffer[m_input_index++]);
+		m_timer_poll->adjust(attotime::never);
+		return;
+	}
+	m_timer_poll->adjust(attotime::from_hz(3125)); // poll once per MIDI byte time
+}
+
+void midi_bridge_device::tra_callback()
+{
+	output_rxd(transmit_register_get_data_bit());
+}
+
+void midi_bridge_device::tra_complete()
+{
+	update_queue(0);
+}
+
+void midi_bridge_device::rcv_complete()
+{
+	receive_register_extract();
+	m_stream->output(get_received_char());
+}
