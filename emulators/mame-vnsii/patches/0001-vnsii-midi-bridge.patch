+#ifndef MAME_BUS_RS232_MIDI_BRIDGE_H
+#define MAME_BUS_RS232_MIDI_BRIDGE_H
+
+#pragma once
+
+#include "rs232.h"
+#include "imagedev/bitbngr.h"
+#include "diserial.h"
+
+// Serial MIDI interface on a Mac modem/printer port: 31250 Bd 8N1, raw MIDI bytes to and from a bitbanger
+// stream (e.g. -bitb socket.127.0.0.1:5001). The 1 MHz interface clock on HSKi/TRxC is set in the machine driver.
+class midi_bridge_device : public device_t,
+	public device_serial_interface,
+	public device_rs232_port_interface
+{
+public:
+	midi_bridge_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock);
+
+	virtual void input_txd(int state) override { device_serial_interface::rx_w(state); }
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_reset() override ATTR_COLD;
+	virtual void device_add_mconfig(machine_config &config) override ATTR_COLD;
+
+	virtual void tra_callback() override;
+	virtual void tra_complete() override;
+	virtual void rcv_complete() override;
+
+private:
+	TIMER_CALLBACK_MEMBER(update_queue);
+
+	required_device<bitbanger_device> m_stream;
+	uint8_t m_input_buffer[256];
+	uint32_t m_input_count;
+	uint32_t m_input_index;
+	emu_timer *m_timer_poll;
+};
+
+DECLARE_DEVICE_TYPE(MIDI_BRIDGE, midi_bridge_device)
+
+#endif // MAME_BUS_RS232_MIDI_BRIDGE_H
