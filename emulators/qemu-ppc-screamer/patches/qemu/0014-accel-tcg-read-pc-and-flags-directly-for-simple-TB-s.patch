From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marc <marc@schuetze.io>
Date: Sun, 1 Nov 2026 23:15:37 +0100
Subject: [PATCH 14/16] accel/tcg: read pc and flags directly for simple TB
 state

Since get_tb_cpu_state became a TCGCPUOps hook (QEMU 10.1), every TB
lookup pays an indirect call and a struct return, where targets like
ppc used to inline a load of two env fields. For a Mac OS X guest on
qemu-system-ppc this hook sits on every indirect branch.

Let a target describe that its TB state is a pc and a 32-bit flags word
at fixed env offsets (cs_base 0); accel/tcg then reads them directly.
ppc opts in outside CONFIG_DEBUG_TCG, where its hook also verifies
hflags.
---
 accel/tcg/cpu-exec.c        | 30 +++++++++++++++++++++++++++---
 include/accel/tcg/cpu-ops.h | 10 ++++++++++
 target/ppc/cpu_init.c       |  6 ++++++
 3 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index a2eb91ef6..7aa906390 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -374,6 +374,30 @@ static inline bool check_for_breakpoints(CPUState *cpu, vaddr pc,
  * If found, return the code pointer.  If not found, return
  * the tcg epilogue so that we return into cpu_tb_exec.
  */
+/*
+ * The TB state of the current CPU. Targets whose state is just a pc and a
+ * flags word in env describe them in TCGCPUOps, which avoids an indirect
+ * call and a struct return on every indirect branch of the guest.
+ */
+static inline TCGTBCPUState tb_cpu_state(CPUState *cpu)
+{
+    const TCGCPUOps *ops = cpu->cc->tcg_ops;
+
+    if (ops->tb_state_pc_size) {
+        const char *env = (const char *)cpu_env(cpu);
+        TCGTBCPUState s;
+
+        s.pc = ops->tb_state_pc_size == 4
+            ? *(const uint32_t *)(env + ops->tb_state_pc_offset)
+            : *(const uint64_t *)(env + ops->tb_state_pc_offset);
+        s.flags = *(const uint32_t *)(env + ops->tb_state_flags_offset);
+        s.cflags = 0;
+        s.cs_base = 0;
+        return s;
+    }
+    return ops->get_tb_cpu_state(cpu);
+}
+
 const void *HELPER(lookup_tb_ptr)(CPUArchState *env)
 {
     CPUState *cpu = env_cpu(env);
@@ -388,7 +412,7 @@ const void *HELPER(lookup_tb_ptr)(CPUArchState *env)
      */
     cpu->neg.can_do_io = true;
 
-    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    TCGTBCPUState s = tb_cpu_state(cpu);
     s.cflags = curr_cflags(cpu);
 
     if (check_for_breakpoints(cpu, s.pc, &s.cflags)) {
@@ -560,7 +584,7 @@ void cpu_exec_step_atomic(CPUState *cpu)
         g_assert(!cpu->running);
         cpu->running = true;
 
-        TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+        TCGTBCPUState s = tb_cpu_state(cpu);
         s.cflags = curr_cflags(cpu);
 
         /* Execute in a serial context. */
@@ -946,7 +970,7 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
 
         while (!cpu_handle_interrupt(cpu, &last_tb)) {
             TranslationBlock *tb;
-            TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+            TCGTBCPUState s = tb_cpu_state(cpu);
             s.cflags = cpu->cflags_next_tb;
 
             /*
diff --git a/include/accel/tcg/cpu-ops.h b/include/accel/tcg/cpu-ops.h
index 3ff6e6810..c1e3623be 100644
--- a/include/accel/tcg/cpu-ops.h
+++ b/include/accel/tcg/cpu-ops.h
@@ -71,6 +71,16 @@ struct TCGCPUOps {
      * Fill in all data required to select or compile a TranslationBlock.
      */
     TCGTBCPUState (*get_tb_cpu_state)(CPUState *cs);
+    /**
+     * @tb_state_pc_size: if non-zero, @get_tb_cpu_state returns pc =
+     * the @tb_state_pc_size bytes (4 or 8) at @tb_state_pc_offset and
+     * flags = the uint32_t at @tb_state_flags_offset of the CPU env, with
+     * cs_base 0. accel/tcg then reads them directly on the TB lookup fast
+     * path instead of calling the hook.
+     */
+    uint8_t tb_state_pc_size;
+    uint32_t tb_state_pc_offset;
+    uint32_t tb_state_flags_offset;
     /**
      * @synchronize_from_tb: Synchronize state from a TCG #TranslationBlock
      *
diff --git a/target/ppc/cpu_init.c b/target/ppc/cpu_init.c
index c23ef680b..0537b22f8 100644
--- a/target/ppc/cpu_init.c
+++ b/target/ppc/cpu_init.c
@@ -7489,6 +7489,12 @@ static const TCGCPUOps ppc_tcg_ops = {
   .initialize = ppc_translate_init,
   .translate_code = ppc_translate_code,
   .get_tb_cpu_state = ppc_get_tb_cpu_state,
+#ifndef CONFIG_DEBUG_TCG
+  /* same as ppc_get_tb_cpu_state(), which also checks hflags in debug builds */
+  .tb_state_pc_size = sizeof(target_ulong),
+  .tb_state_pc_offset = offsetof(CPUPPCState, nip),
+  .tb_state_flags_offset = offsetof(CPUPPCState, hflags),
+#endif
   .restore_state_to_opc = ppc_restore_state_to_opc,
   .mmu_index = ppc_cpu_mmu_index,
 
