+static int screamer_transfer(ScreamerState *s, int due)
+{
+    DBDMA_channel *ch = s->tx;
+    DBDMA_io *io = &ch->io;
+    MemReentrancyGuard *audio = &DEVICE(s)->mem_reentrancy_guard;
+    MemReentrancyGuard *dma =
+        &DEVICE(dbdma_from_ch(s->tx))->mem_reentrancy_guard;
+    bool was_audio = audio->engaged_in_io;
+    bool was_dma = dma->engaged_in_io;
+    uint8_t buf[MAX_FRAMES * FRAME_BYTES];
+
+    /* Descriptor and PCM addresses may point back into either device. */
+    audio->engaged_in_io = dma->engaged_in_io = true;
+    /* Empty, sub-frame and non-stream commands also spend a descriptor slot. */
+    for (int i = 0; i < 64 && DBDMA_channel_running(ch); i++) {
+        int frames, bytes;
+
+        if (!io->processing) {
+            DBDMA_run_channel(ch);
+            if (!io->processing) {
+                continue;
+            }
+        }
 
-    /* A trailing partial frame can never be transferred: drop it */
-    if (io->len && (io->len >> s->shift) == 0) {
-        io->addr += io->len;
+        frames = MIN(due, io->len / FRAME_BYTES);
+        bytes = frames * FRAME_BYTES;
+
+        if (bytes) {
+            int space = fifo8_num_free(&s->fifo);
+
+            dma_memory_read(&address_space_memory, io->addr, buf, bytes,
+                            MEMTXATTRS_UNSPECIFIED);
+            if (bytes > space) {
+                /* Keep the guest clock running if the host stops consuming. */
+                fifo8_drop(&s->fifo, bytes - space);
+            }
+            fifo8_push_all(&s->fifo, buf, bytes);
+            io->addr += bytes;
+            io->len -= bytes;
+            s->regs[FRAME_CNT_REG] += frames;
+            due -= frames;
+        }
+        if (io->len >= FRAME_BYTES) {
+            break;
+        }
+        /* A trailing partial frame can never be transferred: drop it */
         io->len = 0;
-    }
-
