+#define FRAME_BYTES 4            /* big-endian s16 stereo */
+#define TICK_NS (SCALE_MS / 2)
+#define PREBUFFER_MS 20
+#define MAX_RATE 44100
+/* One millisecond at the fastest trimmed rate, rounded up. */
+#define MAX_FRAMES DIV_ROUND_UP(MAX_RATE + MAX_RATE / 200, 1000)
 
