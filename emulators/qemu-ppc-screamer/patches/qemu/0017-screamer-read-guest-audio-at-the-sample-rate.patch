+        /* Repay stalls at up to twice virtual time, at most 1 ms per call. */
+        s->lag_ns += elapsed;
+        step = MIN(s->lag_ns, 2 * MIN(elapsed, TICK_NS));
+        s->lag_ns -= step;
+        s->last_ns = now;
+        s->fraction += step * rate;
