diff --git a/tests/qtest/screamer-test.c b/tests/qtest/screamer-test.c
new file mode 100644
index 000000000..350a06d02
--- /dev/null
+++ b/tests/qtest/screamer-test.c
@@ -0,0 +1,313 @@
+/*
+ * PowerMac Screamer output tests.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "hw/ppc/mac_dbdma.h"
+#include "qemu/bswap.h"
+
+#define MACIO       0x80000000u
+#define TX          (MACIO + 0x8800)
+#define SOUND       (MACIO + 0x14000)
+#define FRAME_COUNT (SOUND + 0x50)
+#define COMMANDS    0x10000
+#define PCM         0x20000
+
+static void write_le32(QTestState *qts, uint32_t addr, uint32_t value)
+{
+    uint32_t le = cpu_to_le32(value);
+
+    qtest_memwrite(qts, addr, &le, sizeof(le));
+}
+
+static uint32_t read_le32(QTestState *qts, uint32_t addr)
+{
+    uint32_t le;
+
+    qtest_memread(qts, addr, &le, sizeof(le));
+    return le32_to_cpu(le);
+}
+
+static void map_macio(QTestState *qts)
+{
+    /* Program the MacIO BAR through UniNorth's PCI config window. */
+    write_le32(qts, 0xf2800000, 0x80006000);
+    g_assert_cmphex(read_le32(qts, 0xf2c00000), ==, 0x0022106b);
+    write_le32(qts, 0xf2800000, 0x80006010);
+    write_le32(qts, 0xf2c00000, MACIO);
+    write_le32(qts, 0xf2800000, 0x80006004);
+    write_le32(qts, 0xf2c00000, 2);
+}
+
+static QTestState *boot(const char *audiodev)
+{
+    QTestState *qts = qtest_initf("-M mac99 -cpu 7400 -nodefaults "
+                                  "-audiodev %s -global screamer.audiodev=snd",
+                                  audiodev);
+
+    map_macio(qts);
+    return qts;
+}
+
+static void descriptor(QTestState *qts, int index, uint16_t cmd,
+                       uint16_t bytes, int branch)
+{
+    dbdma_cmd desc = {
+        .command = cpu_to_le16(cmd),
+        .req_count = cpu_to_le16(bytes),
+        .phy_addr = cpu_to_le32(PCM),
+        .cmd_dep = cpu_to_le32(COMMANDS + branch * sizeof(desc)),
+    };
+
+    qtest_memwrite(qts, COMMANDS + index * sizeof(desc), &desc, sizeof(desc));
+}
+
+static void control(QTestState *qts, uint16_t mask, uint16_t value)
+{
+    write_le32(qts, TX, (uint32_t)mask << 16 | value);
+}
+
+static void start(QTestState *qts)
+{
+    write_le32(qts, TX + 4 * DBDMA_CMDPTR_LO, COMMANDS);
+    control(qts, RUN, RUN);
+}
+
+static void test_pacing(void)
+{
+    QTestState *qts = boot("none,id=snd");
+
+    qtest_irq_intercept_in(qts, "pic");
+    descriptor(qts, 0, OUTPUT_MORE, 16 * 4, 0);
+    descriptor(qts, 1, DBDMA_NOP, 0, 0);
+    descriptor(qts, 2, OUTPUT_LAST | BR_ALWAYS | INTR_ALWAYS, 16 * 4, 0);
+    start(qts);
+
+    for (int i = 1; i <= 44; i++) {
+        int64_t deadline = DIV_ROUND_UP((int64_t)i * 1000000000, 44100);
+
+        qtest_clock_set(qts, deadline - 1);
+        g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, i - 1);
+        g_assert_cmpint(qtest_get_irq(qts, 9), ==, i > 32);
+        qtest_clock_set(qts, deadline);
+        g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, i);
+        g_assert_cmpint(qtest_get_irq(qts, 9), ==, i >= 32);
+    }
+    qtest_quit(qts);
+}
+
+static void test_counter_write(void)
+{
+    QTestState *qts = boot("none,id=snd");
+
+    descriptor(qts, 0, OUTPUT_MORE | BR_ALWAYS, 512, 0);
+    start(qts);
+    qtest_clock_step(qts, 250000);
+    write_le32(qts, FRAME_COUNT, UINT32_MAX - 3);
+    qtest_clock_step(qts, 250000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 7);
+    qtest_quit(qts);
+}
+
+static void test_abort(gconstpointer data)
+{
+    int flush = GPOINTER_TO_INT(data);
+    QTestState *qts = boot("none,id=snd");
+    dbdma_cmd desc;
+
+    descriptor(qts, 0, OUTPUT_MORE, 512, 0);
+    descriptor(qts, 1, OUTPUT_LAST | INTR_ALWAYS, 4, 0);
+    start(qts);
+    qtest_clock_step(qts, 777777);
+    control(qts, flush ? FLUSH : RUN, flush ? FLUSH : 0);
+    qtest_memread(qts, COMMANDS, &desc, sizeof(desc));
+    g_assert_cmpuint(le16_to_cpu(desc.res_count), ==, 512 - 34 * 4);
+    g_assert_cmphex(le16_to_cpu(desc.xfer_status), ==,
+                    RUN | ACTIVE | (flush ? FLUSH : 0));
+    qtest_clock_step(qts, 100000000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 34);
+    g_assert_cmphex(read_le32(qts, TX + 4 * DBDMA_CMDPTR_LO), ==, COMMANDS);
+    qtest_memread(qts, COMMANDS + sizeof(desc), &desc, sizeof(desc));
+    g_assert_cmphex(desc.xfer_status, ==, 0);
+
+    start(qts);
+    qtest_clock_step(qts, 500000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 56);
+    qtest_quit(qts);
+}
+
+static void test_pause_wait(void)
+{
+    QTestState *qts = boot("none,id=snd");
+
+    write_le32(qts, TX + 4 * DBDMA_WAIT_SEL, 0x10001);
+    write_le32(qts, TX + 4 * DBDMA_BRANCH_SEL, 0x10001);
+    descriptor(qts, 0, OUTPUT_MORE | WAIT_IFCLR | BR_IFSET, 32 * 4, 2);
+    descriptor(qts, 1, OUTPUT_MORE, 512, 0);
+    descriptor(qts, 2, OUTPUT_LAST | WAIT_ALWAYS, 4, 0);
+    start(qts);
+    qtest_clock_step(qts, 250000);
+    control(qts, PAUSE, PAUSE);
+    qtest_clock_step(qts, 100000000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 11);
+    control(qts, PAUSE, 0);
+    qtest_clock_step(qts, 100000000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 32);
+    g_assert_cmphex(read_le32(qts, TX + 4 * DBDMA_CMDPTR_LO), ==, COMMANDS);
+    control(qts, 1, 1);
+    qtest_clock_step(qts, 100000000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 33);
+    g_assert_cmphex(read_le32(qts, TX + 4 * DBDMA_CMDPTR_LO), ==,
+                    COMMANDS + 2 * sizeof(dbdma_cmd));
+    qtest_quit(qts);
+}
+
+static void test_empty_loop(gconstpointer data)
+{
+    QTestState *qts = boot("none,id=snd");
+    int bytes = GPOINTER_TO_INT(data);
+
+    descriptor(qts, 0, OUTPUT_LAST | BR_ALWAYS, bytes, 0);
+    start(qts);
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmphex(read_le32(qts, TX + 4 * DBDMA_STATUS) & BT, ==, BT);
+    control(qts, RUN, 0);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_nop_chain(void)
+{
+    QTestState *qts = boot("none,id=snd");
+
+    for (int i = 0; i < 130; i++) {
+        descriptor(qts, i, DBDMA_NOP, 0, 0);
+    }
+    descriptor(qts, 130, OUTPUT_MORE | BR_ALWAYS, 512, 130);
+    start(qts);
+    qtest_clock_step(qts, 500000);
+    g_assert_cmphex(read_le32(qts, TX + 4 * DBDMA_CMDPTR_LO), <,
+                    COMMANDS + 130 * sizeof(dbdma_cmd));
+    qtest_clock_step(qts, 500000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 44);
+    qtest_quit(qts);
+}
+
+static void test_reset(void)
+{
+    QTestState *qts = boot("none,id=snd");
+
+    descriptor(qts, 0, OUTPUT_MORE, 512, 0);
+    start(qts);
+    qtest_clock_step(qts, 500000);
+    qtest_system_reset(qts);
+    map_macio(qts);
+    qtest_clock_step(qts, 100000000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 0);
+    g_assert_cmphex(read_le32(qts, TX + 4 * DBDMA_STATUS), ==, 0);
+    descriptor(qts, 0, OUTPUT_LAST, 4, 0);
+    descriptor(qts, 1, DBDMA_STOP, 0, 0);
+    start(qts);
+    qtest_clock_step(qts, 500000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_rates(void)
+{
+    static const int rates[] = {
+        44100, 29400, 22050, 17640, 14700, 11025, 8820, 7350
+    };
+    QTestState *qts = boot("none,id=snd");
+    int64_t phase = 0;
+
+    descriptor(qts, 0, OUTPUT_MORE | BR_ALWAYS, 256, 0);
+    start(qts);
+    for (int i = 0; i < ARRAY_SIZE(rates); i++) {
+        write_le32(qts, SOUND, i << 8);
+        qtest_clock_step(qts, 1250000);
+        phase += 1250000LL * rates[i];
+    }
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, phase / 1000000000);
+    qtest_quit(qts);
+}
+
+static void test_short_sound(gconstpointer data)
+{
+    g_autofree char *path = NULL;
+    g_autofree char *audiodev = NULL;
+    g_autofree char *wav = NULL;
+    int rate = GPOINTER_TO_INT(data);
+    uint8_t samples[32 * 4];
+    size_t length;
+    QTestState *qts;
+    int fd = g_file_open_tmp("screamer-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    audiodev = g_strdup_printf("wav,id=snd,out.frequency=%d,path=%s",
+                               rate, path);
+    qts = boot(audiodev);
+    descriptor(qts, 0, OUTPUT_LAST, sizeof(samples), 0);
+    descriptor(qts, 1, DBDMA_STOP, 0, 0);
+    start(qts);
+
+    for (int i = 0; i < 32; i++) {
+        /* Set each stereo frame just before its sample deadline. */
+        int periods = i + 1;
+        uint8_t *frame = samples + 4 * i;
+
+        if (rate == 22050 && i >= 16) {
+            if (i == 16) {
+                qtest_clock_set(qts, DIV_ROUND_UP(16000000000LL, 44100));
+                write_le32(qts, SOUND, 2 << 8);
+            }
+            periods += i + 1 - 16;
+        }
+        qtest_clock_set(qts, DIV_ROUND_UP(periods * 1000000000LL, 44100) - 1);
+        stw_be_p(frame, 0x1000 + i);
+        stw_be_p(frame + 2, 0x7000 - i);
+        qtest_memwrite(qts, PCM + 4 * i, frame, 4);
+    }
+    qtest_clock_step(qts, 100000000);
+    g_assert_cmpuint(read_le32(qts, FRAME_COUNT), ==, 32);
+    qtest_qmp_assert_success(qts, "{ 'execute': 'quit' }");
+    qtest_wait_qemu(qts);
+    qtest_quit(qts);
+
+    g_assert_true(g_file_get_contents(path, &wav, &length, NULL));
+    unlink(path);
+    g_assert_cmpuint(length, ==, 44 + sizeof(samples));
+    for (int i = 0; i < sizeof(samples); i += 2) {
+        g_assert_cmphex(lduw_le_p(wav + 44 + i), ==, lduw_be_p(samples + i));
+    }
+}
+
+int main(int argc, char **argv)
+{
