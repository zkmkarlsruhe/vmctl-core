+#ifndef HW_AUDIO_SCREAMER_H
+#define HW_AUDIO_SCREAMER_H
+
+#include "qemu/osdep.h"
+#include "hw/sysbus.h"
+
+#define TYPE_SCREAMER "screamer"
+OBJECT_DECLARE_SIMPLE_TYPE(ScreamerState, SCREAMER)
+
+struct ScreamerState {
+    /*< private >*/
+    SysBusDevice parent_obj;
+
+    /*< public >*/
+    MemoryRegion mem;
+    qemu_irq irq;
+};
+
+#endif
