from collections.abc import Callable, Iterable, Mapping, Sequence

Pairs = (
    Mapping[str, bytes]
    | Mapping[bytes, bytes]
    | Mapping[str | bytes, bytes]
    | Iterable[tuple[str | bytes, bytes]]
)
Frame = tuple[bytes, bytes, list[tuple[bytes, bytes]], bytes, bytes]

CODES: tuple[str, ...]

class FrameError(Exception):
    code: str
    id: bytes | None
    def __init__(self, code: str, id: bytes | None = ...) -> None: ...

def escape(value: bytes) -> bytes: ...
def unescape(value: bytes) -> bytes: ...
def encode_kv(kv: Pairs) -> bytes: ...
def decode_body(kind: str | bytes, body: bytes) -> tuple[list[tuple[bytes, bytes]], bytes]: ...
def encode_rows(columns: Sequence[bytes], rows: Iterable[Sequence[bytes]]) -> bytes: ...
def decode_rows(payload: bytes) -> tuple[list[bytes], list[list[bytes]]]: ...
def numbered_kv(
    values: Sequence[bytes], prefix: str | bytes = ...
) -> list[tuple[bytes, bytes]]: ...
def numbered_list(kv: Pairs, prefix: str | bytes = ...) -> list[bytes]: ...
def encode_frame(
    id: str | bytes, type: str | bytes, kv: Pairs, payload_kind: str | bytes, payload: bytes
) -> bytes: ...
def error_frame(id: str | bytes, code: str, msg: bytes, kv: Pairs = ...) -> bytes: ...
def self_test() -> None: ...

class FrameReader:
    max_frame: int
    def __init__(self, read_fn: Callable[[int], bytes], max_frame: int) -> None: ...
    def next(self) -> Frame: ...
    def __next__(self) -> Frame: ...
    def __iter__(self) -> FrameReader: ...

class ReplyCache:
    running: dict[bytes, bool]
    replies: dict[bytes, bytes]
    order: list[bytes]
    def __init__(self) -> None: ...
    def begin(self, id: str | bytes) -> tuple[str, bytes | None]: ...
    def finish(self, id: str | bytes, reply: bytes) -> None: ...
