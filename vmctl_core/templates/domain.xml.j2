{%- if hw.arch == 'ppc' -%}
{# ---- PowerPC / mac99 (Mac OS 9, screamer-audio fork) ----------------------- #}
{# TCG (no KVM on x86 host for ppc), OpenBIOS (no Mac ROM), <1024 MB RAM. mac99   #}
{# uses an onboard macio-IDE + sungem NIC + std VGA that libvirt CANNOT express,   #}
{# so disks/CD/boot-order/NIC/VGA/input + the load-bearing prom-env + screamer     #}
{# -audiodev ALL ride in <qemu:commandline> (research/33b, research/38).           #}
{#                                                                                  #}
{# NIC — the load-bearing detail (PROVEN 2026-06-22 on rvmc-ck1/2/3 + the golden): #}
{# a managed <interface model='sungem'> is WRONG. libvirt always lands a managed   #}
{# interface on a PCI bus (AGP / pci.0); OS 9 Open Transport cannot bind sungem    #}
{# there → the NIC never appears → no DHCP. The working form is a RAW cmdline NIC  #}
{# with NO bus/addr: qemu then auto-places sungem on pci.2 (the uni-north main bus #}
{# where macio lives), exactly where OS 9 binds "Ethernet (built-in)". The tap is  #}
{# a per-instance device ({{ tap }}) created on virbr0 by clone.py BEFORE define,   #}
{# owned by the qemu user (qemu.conf namespaces=[] + /dev/net/tun in              #}
{# cgroup_device_acl). domifaddr CANNOT see a qemu:commandline NIC, so guest_ip()  #}
{# discovers the lease by parsing dnsmasq/virbr0.status by MAC (libvirt_backend).  #}
<domain type='qemu' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>{{ name }}</name>
  <uuid>{{ uuid }}</uuid>
  <title>{{ title }}</title>
  <memory unit='MiB'>{{ hw.memory_mb }}</memory>
  <currentMemory unit='MiB'>{{ hw.memory_mb }}</currentMemory>
  <vcpu placement='static'>{{ hw.vcpus }}</vcpu>
  <os>
    <type arch='ppc' machine='{{ hw.machine }}'>hvm</type>
  </os>
  {# no <cpu> element: libvirt's CPU driver can't validate ppc models. -cpu g4 via cmdline. #}
  <clock offset='{{ hw.clock }}'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>{{ emulator }}</emulator>
    {# NO managed <interface> here: a libvirt-managed sungem lands on a PCI bus OS 9
       can't bind. The NIC is a raw -netdev tap / -device sungem in <qemu:commandline>
       (no bus → qemu auto-places it on pci.2 where OS 9 finds it). See header. #}
    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video>
      <model type='none'/>
    </video>
  </devices>
  <qemu:commandline>
    {# libvirt emits -M from <type machine> (it rejects machine='mac99,via=cuda'). We #}
    {# re-issue -machine via=<via> here so qemu MERGES the via property onto that -M:  #}
    {# via=pmu => OS X / install default; via=cuda => the OS-9 native-mouse fix path   #}
    {# (research/48) where the Elliot-Nunn nvramrc tablet driver + usb-tablet make the #}
    {# cursor track 1:1 over noVNC. usb-tablet (absolute) replaces usb-mouse (relative,#}
    {# offsets over VNC) when hw.usb_tablet is set. The nvramrc blob itself rides in   #}
    {# hw.prom_env (use-nvramrc?=true + nvramrc=<blob>) — no template change needed.   #}
    <qemu:arg value='-machine'/>
    <qemu:arg value='via={{ hw.via }}'/>
    <qemu:arg value='-cpu'/>
    <qemu:arg value='{{ hw.cpu_model or 'g4' }}'/>
    <qemu:arg value='-boot'/>
    <qemu:arg value='{{ "d" if hw.boot_dev == "cdrom" else "c" }}'/>
{%- for pe in hw.prom_env %}
    <qemu:arg value='-prom-env'/>
    <qemu:arg value='{{ pe }}'/>
{%- endfor %}
    {# RAW tap NIC (PROVEN, research/58). NO bus/addr on -device sungem → qemu auto-
       lands it on pci.2 (uni-north main bus, where macio lives) so OS 9 Open Transport
       binds "Ethernet (built-in)" and pulls a DHCP lease. The {{ tap }} tap is created
       on virbr0 by clone.py (owned by the qemu user) BEFORE this domain is defined;
       script=no/downscript=no so qemu neither (re)creates nor tears down the tap. #}
    <qemu:arg value='-netdev'/>
    <qemu:arg value='tap,id=net0,ifname={{ tap }},script=no,downscript=no'/>
    <qemu:arg value='-device'/>
    <qemu:arg value='sungem,netdev=net0,mac={{ mac }}'/>
    <qemu:arg value='-device'/>
    <qemu:arg value='VGA'/>
    <qemu:arg value='-usb'/>
    <qemu:arg value='-device'/>
{%- if hw.usb_tablet %}
    {# absolute pointer — OS 9 drives it via the nvramrc/INIT tablet driver (research/48) #}
    <qemu:arg value='usb-tablet'/>
{%- else %}
    <qemu:arg value='usb-mouse'/>
{%- endif %}
    <qemu:arg value='-device'/>
    <qemu:arg value='usb-kbd'/>
    <qemu:arg value='-drive'/>
    <qemu:arg value='file={{ disk_path }},format=qcow2,media=disk,index=0'/>
{%- if boot_iso %}
    <qemu:arg value='-drive'/>
    <qemu:arg value='file={{ boot_iso }},format=raw,media=cdrom,index=2'/>
{%- endif %}
    <qemu:arg value='-audiodev'/>
{%- if hw.audio_sink %}
    <qemu:arg value='pa,id=audio1,server={{ pulse_server }},out.name={{ hw.audio_sink }},out.frequency=44100'/>
{%- else %}
    {# screamer is auto-added by mac99 + needs an explicit audiodev (default is rejected) #}
    <qemu:arg value='none,id=audio1'/>
{%- endif %}
  </qemu:commandline>
</domain>
{%- elif hw.macos -%}
{# ---- macOS-x86 (Hackintosh-style: Snow Leopard 10.6 ..., Intel) ------------ #}
{# KVM + OVMF firmware (-bios via <loader type='rom'>) + a Penryn CPU spoofing    #}
{# GenuineIntel (the <vendor> is load-bearing only on AMD/EPYC hosts; a no-op on   #}
{# Intel). The Apple SMC is macOS's boot gate and has NO native libvirt element,   #}
{# so isa-applesmc,osk rides in <qemu:commandline> — the same escape-hatch the ppc #}
{# branch uses for prom-env. Boot chain: OpenCore (a shared read-only aux disk)    #}
{# chainloads the installed macOS on the main clone disk. Graphics via vmware-svga #}
{# (macOS in-box driver -> real resolution); NO accelerated GL (no QE/CI), so      #}
{# guest-side screencapture can't grab a frame -> the host screenshots via QMP.    #}
{# USB input (macOS ignores ps2). No virtio anywhere (no macOS driver): e1000 NIC, #}
{# no balloon, no virtio-serial -> the guest agent runs legacy-TCP on :9009 over    #}
{# the NAT NIC (research/64 tiger tier), NOT a vioser channel. VERIFIED on 10.6.3. #}
<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>{{ name }}</name>
  <uuid>{{ uuid }}</uuid>
  <title>{{ title }}</title>
  <memory unit='MiB'>{{ hw.memory_mb }}</memory>
  <currentMemory unit='MiB'>{{ hw.memory_mb }}</currentMemory>
  <vcpu placement='static'>{{ hw.vcpus }}</vcpu>
  <os>
    <type arch='{{ hw.arch }}' machine='{{ hw.machine }}'>hvm</type>
{%- if loader %}
    {# OVMF as -bios (monolithic, non-persistent NVRAM — OpenCore's config lives on
       its own disk, not in NVRAM, so a writable varstore is unnecessary). #}
    <loader type='rom'>{{ loader }}</loader>
{%- endif %}
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  {# Penryn is the newest CPU Snow Leopard's kexts know; <vendor> forces GenuineIntel
     so macOS boots on an AMD/EPYC host too. check='none' — don't validate vs the host. #}
  <cpu mode='custom' match='exact' check='none'>
    <model fallback='allow'>{{ hw.cpu_model or 'Penryn' }}</model>
{%- if hw.cpu_vendor %}
    <vendor>{{ hw.cpu_vendor }}</vendor>
{%- endif %}
{%- for feat in hw.cpu_features %}
    <feature policy='require' name='{{ feat }}'/>
{%- endfor %}
    {# SINGLE SOCKET — load-bearing for macOS. libvirt's default topology is one
       socket PER vcpu (sockets=N); macOS then fails inter-socket TSC sync and hangs
       right after OpenCore hands off to boot.efi (no kernel output) — the symptom
       misread as an "AMD kernel wall". Collapsing every vcpu into ONE socket makes
       Snow Leopard 10.6 boot to the desktop under KVM on an AMD/EPYC host (verified
       2026-07-30, vmctl-lab EPYC). All cores in one socket, no SMT. #}
    <topology sockets='1' cores='{{ hw.vcpus }}' threads='1'/>
  </cpu>
  <clock offset='{{ hw.clock }}'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>{{ emulator }}</emulator>
{%- for aux in aux_disks_resolved %}
    {# OpenCore (or other) boot disk — a PER-CLONE writable overlay on a shared read-only
       base (clone.py creates it, like the main disk); boots first, then chainloads macOS
       off the main clone disk. `aux.path` is the per-clone overlay (writable). #}
    {%- set _pfx = 'hd' if aux.bus == 'ide' else ('vd' if aux.bus == 'virtio' else 'sd') %}
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{ aux.path }}'/>
      {# dev letters start at 'b' so an aux never collides with the main disk's 'a' slot #}
      <target dev='{{ _pfx ~ 'bcdefgh'[loop.index0] }}' bus='{{ aux.bus }}'/>
      <boot order='{{ aux.boot }}'/>
    </disk>
{%- endfor %}
    {# main clone disk (the installed macOS golden) — boots after the OpenCore disk. #}
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{ disk_path }}'/>
      <target dev='{{ hw.disk_dev }}' bus='{{ hw.disk_bus }}'/>
      <boot order='{{ (aux_disks_resolved | length) + 1 }}'/>
    </disk>
    <interface type='network'>
      <mac address='{{ mac }}'/>
      <source network='{{ network }}'/>
      <model type='{{ hw.nic_model }}'/>
    </interface>
    {# EXPLICIT ICH9 EHCI + UHCI companions. Without a controller element libvirt gives q35 its
       default, which on current libvirt is qemu-xhci (USB 3.0) — and macOS gained no xHCI driver
       until 10.8.2, so on Snow Leopard the tablet and keyboard below hang off a bus the guest
       cannot see: no pointer, no keys, and ps2 is no fallback because macOS has no ps2 driver
       either. ICH9 is also what the period hardware had, and 10.6 ships AppleUSBEHCI/UHCI. The
       UHCI companions are required, not decoration: usb-tablet and usb-kbd are full-speed USB 1.x
       devices and cannot attach to EHCI alone. #}
    <controller type='usb' index='0' model='ich9-ehci1'/>
    <controller type='usb' index='0' model='ich9-uhci1'>
      <master startport='0'/>
    </controller>
    <controller type='usb' index='0' model='ich9-uhci2'>
      <master startport='2'/>
    </controller>
    <controller type='usb' index='0' model='ich9-uhci3'>
      <master startport='4'/>
    </controller>
{%- if hw.usb_tablet %}
    <input type='tablet' bus='usb'/>
{%- endif %}
    {# USB keyboard (macOS has no ps2 keyboard driver on this machine type). #}
    <input type='keyboard' bus='usb'/>
    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video>
{%- if hw.video in ['vga', 'cirrus', 'vmvga'] %}
      <model type='{{ hw.video }}' vram='{{ hw.vgamem_kib }}' heads='1' primary='yes'/>
{%- else %}
      <model type='{{ hw.video }}' heads='1' primary='yes'/>
{%- endif %}
    </video>
  </devices>
{%- if hw.smc or hw.cpu_vendor %}
  <qemu:commandline>
{%- if hw.cpu_vendor %}
    {# CPU VENDOR SPOOF — load-bearing on an AMD/EPYC host. libvirt's <cpu><vendor>
       is dropped from the generated -cpu (it treats the model's default vendor as
       redundant), but on AMD+KVM a bare `-cpu Penryn` leaks the host's AuthenticAMD
       in CPUID leaf 0 and macOS refuses to boot (hangs at boot.efi, no kernel
       output). qemu takes the LAST -cpu, so this trailing override forces the real
       Intel vendor string + the model/features; the <cpu> element above still drives
       the single-socket -smp topology. Verified with the topology fix on vmctl-lab
       (EPYC) 2026-07-30 — both are required to boot Snow Leopard under KVM on AMD. #}
    <qemu:arg value='-cpu'/>
    <qemu:arg value='{{ hw.cpu_model or "Penryn" }},vendor=GenuineIntel{% for f in hw.cpu_features %},+{{ f }}{% endfor %}'/>
{%- endif %}
{%- if hw.smc %}
    {# Apple SMC — macOS's boot gate. No native libvirt element, so inject it raw.
       osk is the 64-char key; the public Snow Leopard key works for 10.6. #}
    <qemu:arg value='-device'/>
    <qemu:arg value='isa-applesmc,osk={{ hw.osk }}'/>
{%- endif %}
  </qemu:commandline>
{%- endif %}
</domain>
{%- else -%}
<domain type='kvm'>
  <name>{{ name }}</name>
  <uuid>{{ uuid }}</uuid>
  <title>{{ title }}</title>
  <memory unit='MiB'>{{ hw.memory_mb }}</memory>
  <currentMemory unit='MiB'>{{ hw.memory_mb }}</currentMemory>
  <vcpu placement='static'>{{ hw.vcpus }}</vcpu>
  <os>
    <type arch='{{ hw.arch }}' machine='{{ hw.machine }}'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
{%- if hw.hyperv %}
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
    </hyperv>
{%- endif %}
    <vmport state='{{ "on" if hw.vmport else "off" }}'/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='on'/>
  <clock offset='{{ hw.clock }}'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
{%- if hw.hyperv %}
    <timer name='hypervclock' present='yes'/>
{%- endif %}
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>{{ emulator }}</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{ disk_path }}'/>
      <target dev='{{ hw.disk_dev }}' bus='{{ hw.disk_bus }}'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <target dev='hdc' bus='ide'/>
      <readonly/>
    </disk>
{%- if hw.virtio_serial %}
    {#- virtio-serial controller(s). One controller exposes 31 usable ports (port 0 is
        the console). The channels we may attach are: the qemu guest-agent channel (1)
        + the agent lane pool (len(agent_socks), research/56). When that total exceeds a
        single controller we emit extra controllers and pin each channel to one via an
        explicit <address>. In the common case (<= one controller's worth of channels)
        we emit a single bare controller and NO per-channel addresses, so an
        AGENT_LANES=1 (or non-pooled) domain stays byte-for-byte identical to before. -#}
    {%- set _chan_count = (agent_socks | length) + (1 if hw.virtio_serial else 0) %}
    {%- set _max = vioser_max_ports | default(31) %}
    {#- Port 0 on every controller is reserved for the console, so only _max-1 ports
        per controller are usable — the allocator below fills exactly that many, so
        _nctrl must divide by the SAME per-controller capacity or it will emit
        <address controller='N'> for a controller that range(_nctrl) never created. -#}
    {%- set _cap = _max - 1 %}
    {%- set _nctrl = ([_chan_count, 1] | max + _cap - 1) // _cap %}
    {%- if _nctrl < 1 %}{% set _nctrl = 1 %}{% endif %}
    {%- for ci in range(_nctrl) %}
    <controller type='virtio-serial' index='{{ ci }}'/>
    {%- endfor %}
{%- endif %}
    <interface type='network'>
      <mac address='{{ mac }}'/>
      <source network='{{ network }}'/>
      <model type='{{ hw.nic_model }}'/>
    </interface>
{%- if hw.control_nic_enabled %}
    {#- ADDITIONAL isolated host-only CONTROL/management NIC. Two roles, one emit:
        (a) legacy-TCP containment (research/68) — guests with NO virtio-serial
            (win2000/win98/irix) run the agentbox on TCP:9009; without this that
            listener would sit on the NIC above, the same NAT network the untrusted
            artwork uses. hw.mgmt_nic selects this role.
        (b) P3 dual-pipeline FALLBACK — a VIRTIO-SERIAL golden that ALSO sets this
            (hw.control_nic / hw.mgmt_nic) stays dual-homed: vioser primary + this
            control NIC carrying TCP-over-control-NIC that survives a vioser-driver
            wedge. The artwork NIC + vioser channels + qemu-ga above are all unchanged.
        This interface lives on the isolated 'rvmc-mgmt' libvirt network (no <forward>,
        private 10.77.0.0/24 + DHCP — see deploy/networks/rvmc-mgmt.xml), so :9009 on it
        is unreachable from the artwork/exhibition LAN. No <mac>: libvirt auto-assigns.
        control_ip() prefers the 10.77.0.x lease so the controller/tcp_helper dial it.
        MODEL — control_nic_model_effective: e1000 on a vioser golden, a driver
        INDEPENDENT of the virtio-serial that may wedge (that independence is the whole
        point of the fallback); nic_model on a legacy-TCP base, so those domains stay
        byte-for-byte identical. The primary NIC above is unchanged (artwork path); this
        whole block is skipped when neither flag is set, so single-NIC domains stay
        byte-for-byte identical too.
        GUEST-SIDE CAVEAT (NOT emitted here — golden-build / bootstrap workstream): the
        guest MUST set interface metrics so this isolated control NIC (10.77/24, no
        gateway/forward) NEVER becomes the default route (the codex NIC-ordering trap).
        Artwork egress has to stay on the artwork NIC — otherwise the guest black-holes
        outbound traffic at the no-forward mgmt network. -#}
    <interface type='network'>
      <source network='rvmc-mgmt'/>
      <model type='{{ hw.control_nic_model_effective }}'/>
    </interface>
{%- endif %}
    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
{#- Port allocation across the virtio-serial controller(s). Each unix channel below
    consumes one port. We only emit an explicit <address> when more than one controller
    is in play (_nctrl > 1); with a single controller we keep the bare channels so an
    AGENT_LANES=1 / non-pooled domain is byte-for-byte identical to the old XML. Port 0
    on each controller is reserved for the console, so usable ports start at 1. -#}
{%- set _port = namespace(n=1, ctrl=0) %}
{%- if hw.virtio_serial %}
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
{%- if _nctrl > 1 %}
      <address type='virtio-serial' controller='{{ _port.ctrl }}' bus='0' port='{{ _port.n }}'/>
{%- endif %}
    </channel>
{%- if _port.n + 1 >= _max %}{% set _port.ctrl = _port.ctrl + 1 %}{% set _port.n = 1 %}{% else %}{% set _port.n = _port.n + 1 %}{% endif %}
{%- endif %}
{%- if agent_sock %}
    {#- Multi-lane agent channel POOL (research/56): N independent single-client vioser
        lanes — .0 control (status/polls), .1 drive (keys/pointer/screenshot), .2..N-1
        worker pool (heavy eventlog/log/file/shell/exec/installer, dispatched
        round-robin host-side) — so a saturated lane can't head-of-line block the
        others. `agent_socks` is the per-lane bind path list (lane .0 = the legacy
        `<domain>.sock`); falls back to a single .0 lane when only `agent_sock` is
        supplied (old callers). Windows/Linux agent guests only — gated by agent_sock,
        which the controller leaves empty for pristine XP and the agentless mac/ppc
        bases. Pool size is env AGENT_LANES (default 8); AGENT_LANES=1 => lane .0 only,
        reproducing the old single-channel XML. -#}
{%- for sock in (agent_socks or [agent_sock]) %}
    <channel type='unix'>
      <source mode='bind' path='{{ sock }}'/>
      <target type='virtio' name='de.zkm.rvmc.agent.{{ loop.index0 }}'/>
{%- if _nctrl > 1 %}
      <address type='virtio-serial' controller='{{ _port.ctrl }}' bus='0' port='{{ _port.n }}'/>
{%- endif %}
    </channel>
{%- if _port.n + 1 >= _max %}{% set _port.ctrl = _port.ctrl + 1 %}{% set _port.n = 1 %}{% else %}{% set _port.n = _port.n + 1 %}{% endif %}
{%- endfor %}
{%- endif %}
{%- if hw.usb_tablet %}
    <input type='tablet' bus='usb'/>
{%- endif %}
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>
    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video>
{%- if hw.video == 'qxl' %}
      <model type='qxl' ram='{{ hw.qxl_ram_kib }}' vram='{{ hw.qxl_vram_kib }}' vgamem='{{ hw.vgamem_kib }}' heads='1' primary='yes'/>
{%- elif hw.video in ['vga', 'cirrus', 'vmvga'] %}
      <model type='{{ hw.video }}' vram='{{ hw.vgamem_kib }}' heads='1' primary='yes'/>
{%- else %}
      <model type='{{ hw.video }}' heads='1' primary='yes'/>
{%- endif %}
    </video>
    <memballoon model='{{ hw.memballoon }}'/>
  </devices>
</domain>
{%- endif %}
